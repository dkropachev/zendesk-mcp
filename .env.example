# Required tenant unless saved by `zendesk-mcp login`.
ZENDESK_BASE_URL=https://example.zendesk.com

# Preferred durable auth.
# ZENDESK_AUTH_MODE=oauth
# ZENDESK_OAUTH_TOKEN_FILE=/home/YOU/.config/zendesk-mcp/oauth-token

# Deprecated fallback.
# ZENDESK_AUTH_MODE=api_token
# ZENDESK_EMAIL=you@example.com
# ZENDESK_API_TOKEN_FILE=/home/YOU/.config/zendesk-mcp/api-token

# Browser session auth is configured by `bin/zendesk-mcp login`.
# Browser auth is read-only even when write flag is set.
# ZENDESK_AUTH_MODE=browser
# ZENDESK_COOKIE_FILE=/home/YOU/.config/zendesk-mcp/cookie
# ZENDESK_HEADERS_FILE=/home/YOU/.config/zendesk-mcp/headers.json

# Local attachment directories. Tools accept relative paths below these roots.
# ZENDESK_DOWNLOAD_ROOT=/path/to/zendesk-downloads
# ZENDESK_UPLOAD_ROOT=/path/to/zendesk-uploads
# ZENDESK_MAX_DOWNLOAD_BYTES=26214400

# Write tools: disabled by default. OAuth or API-token auth required.
# ZENDESK_ENABLE_WRITE=false

# Request controls.
# ZENDESK_TIMEOUT=60s
# ZENDESK_MAX_RESPONSE_BYTES=8388608
# ZENDESK_MAX_READ_RETRIES=1

# Live test gates. Never point write integration at production.
# ZENDESK_INTEGRATION=1
# ZENDESK_INTEGRATION_TICKET_ID=123
# ZENDESK_INTEGRATION_ALLOW_WRITE=1
# ZENDESK_INTEGRATION_SANDBOX_ACK=https://your-sandbox.zendesk.com
# ZENDESK_INTEGRATION_REQUESTER_ID=456
